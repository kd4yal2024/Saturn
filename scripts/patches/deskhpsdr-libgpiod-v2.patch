+#ifdef GPIOD_V2
+static gpointer monitor_thread(gpointer arg) {
+  const int64_t timeout_ns = 60LL * 1000LL * 1000LL * 1000LL;
+  size_t max_events = (size_t)(lines > 0 ? lines : 1);
+  struct gpiod_edge_event_buffer *event_buffer = NULL;
+
+  // thread to monitor gpio events
+  t_print("%s: monitoring %d lines.\n", __func__, lines);
+
+  if (gpio_device == NULL || monitor_request == NULL) {
+    return NULL;
+  }
+
+  for (int i = 0; i < lines; i++) {
+    t_print("... monitoring line  %u\n", monitor_lines[i]);
+  }
+
+  event_buffer = gpiod_edge_event_buffer_new(max_events);
+
+  if (event_buffer == NULL) {
+    t_print("%s: edge event buffer allocation failed\n", __func__);
+    return NULL;
+  }
+
+  while (monitor_request != NULL) {
+    int ret = gpiod_line_request_wait_edge_events(monitor_request, timeout_ns);
+
+    if (ret < 0) {
+      t_print("%s: wait for edge events failed: %s\n", __func__, g_strerror(errno));
+      break;
+    }
+
+    if (ret == 0) {
+      continue;
+    }
+
+    ret = gpiod_line_request_read_edge_events(monitor_request, event_buffer, max_events);
+
+    if (ret < 0) {
+      t_print("%s: read edge events failed: %s\n", __func__, g_strerror(errno));
+      break;
+    }
+
+    for (int i = 0; i < ret; i++) {
+      struct gpiod_edge_event *event = gpiod_edge_event_buffer_get_event(event_buffer, (unsigned long)i);
+
+      if (event == NULL) {
+        continue;
+      }
+
+      switch (gpiod_edge_event_get_event_type(event)) {
+      case GPIOD_EDGE_EVENT_RISING_EDGE:
+        process_edge(gpiod_edge_event_get_line_offset(event), RELEASED);
+        break;
+
+      case GPIOD_EDGE_EVENT_FALLING_EDGE:
+        process_edge(gpiod_edge_event_get_line_offset(event), PRESSED);
+        break;
+      }
+    }
+  }
+
+  gpiod_edge_event_buffer_free(event_buffer);
+  t_print("%s: exit\n", __func__);
+  return NULL;
+}
