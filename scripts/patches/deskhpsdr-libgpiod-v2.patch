+static void release_request(struct gpiod_line_request **request) {
+  if (*request != NULL) {
+    gpiod_line_request_release(*request);
+    *request = NULL;
+  }
+}
+
+static struct gpiod_line_request *request_single_line(struct gpiod_chip *chip, int offset,
+    enum gpiod_line_direction direction, enum gpiod_line_edge edge,
+    enum gpiod_line_bias bias, enum gpiod_line_value output_value) {
+  struct gpiod_request_config *request_config = NULL;
+  struct gpiod_line_config *line_config = NULL;
+  struct gpiod_line_settings *line_settings = NULL;
+  struct gpiod_line_request *request = NULL;
+  unsigned int line_offset = (unsigned int)offset;
+
+  request_config = gpiod_request_config_new();
+  line_config = gpiod_line_config_new();
+  line_settings = gpiod_line_settings_new();
+
+  if (request_config == NULL || line_config == NULL || line_settings == NULL) {
+    t_print("%s: allocation failed for line %d\n", __func__, offset);
+    goto cleanup;
+  }
+
+  gpiod_request_config_set_consumer(request_config, consumer);
+
+  if (gpiod_line_settings_set_direction(line_settings, direction) < 0) {
+    goto cleanup;
+  }
+
+  if (direction == GPIOD_LINE_DIRECTION_INPUT) {
+    if (gpiod_line_settings_set_edge_detection(line_settings, edge) < 0) {
+      goto cleanup;
+    }
+
+    if (gpiod_line_settings_set_bias(line_settings, bias) < 0) {
+      goto cleanup;
+    }
+  } else if (direction == GPIOD_LINE_DIRECTION_OUTPUT) {
+    if (gpiod_line_settings_set_output_value(line_settings, output_value) < 0) {
+      goto cleanup;
+    }
+  }
+
+  if (gpiod_line_config_add_line_settings(line_config, &line_offset, 1, line_settings) < 0) {
+    goto cleanup;
+  }
+
+  request = gpiod_chip_request_lines(chip, request_config, line_config);
+
+cleanup:
+  if (line_settings != NULL) {
+    gpiod_line_settings_free(line_settings);
+  }
+
+  if (line_config != NULL) {
+    gpiod_line_config_free(line_config);
+  }
+
+  if (request_config != NULL) {
+    gpiod_request_config_free(request_config);
+  }
+
+  return request;
+}
+
+static struct gpiod_line_request *setup_monitor_request(struct gpiod_chip *chip) {
+  struct gpiod_request_config *request_config = NULL;
+  struct gpiod_line_config *line_config = NULL;
+  struct gpiod_line_request *request = NULL;
+
+  request_config = gpiod_request_config_new();
+  line_config = gpiod_line_config_new();
+
+  if (request_config == NULL || line_config == NULL) {
+    t_print("%s: allocation failed\n", __func__);
+    goto cleanup;
+  }
+
+  gpiod_request_config_set_consumer(request_config, consumer);
+  gpiod_request_config_set_event_buffer_size(request_config, (size_t)(lines > 0 ? lines : 1));
+
+  for (int i = 0; i < lines; i++) {
+    struct gpiod_line_settings *line_settings = gpiod_line_settings_new();
+    enum gpiod_line_bias bias = monitor_pullups[i] ? GPIOD_LINE_BIAS_PULL_UP : GPIOD_LINE_BIAS_PULL_DOWN;
+
+    if (line_settings == NULL) {
+      t_print("%s: line settings allocation failed for line %u\n", __func__, monitor_lines[i]);
+      goto cleanup;
+    }
+
+    if (gpiod_line_settings_set_direction(line_settings, GPIOD_LINE_DIRECTION_INPUT) < 0
+        || gpiod_line_settings_set_edge_detection(line_settings, GPIOD_LINE_EDGE_BOTH) < 0
+        || gpiod_line_settings_set_bias(line_settings, bias) < 0
+        || gpiod_line_config_add_line_settings(line_config, &monitor_lines[i], 1, line_settings) < 0) {
+      gpiod_line_settings_free(line_settings);
+      goto cleanup;
+    }
+
+    gpiod_line_settings_free(line_settings);
+  }
+
+  request = gpiod_chip_request_lines(chip, request_config, line_config);
+
+cleanup:
+  if (line_config != NULL) {
+    gpiod_line_config_free(line_config);
+  }
+
+  if (request_config != NULL) {
+    gpiod_request_config_free(request_config);
+  }
+
+  return request;
+}
