+#ifdef GPIOD_V2
+static int setup_input_line(struct gpiod_chip *chip, int offset, gboolean pullup) {
+  //
+  // Set up an input line. If this succeeds, record offset in monitor[]
+  // The full edge-event request is created once all lines are known.
+  //
+  struct gpiod_line_request *request = NULL;
+  int existing;
+  t_print("%s: %d\n", __func__, offset);
+
+  existing = find_monitor_line(offset);
+
+  if (existing >= 0) {
+    if (monitor_pullups[existing] != pullup) {
+      t_print("%s: line %d already registered with different bias, keep first configuration\n", __func__, offset);
+    }
+
+    return 0;
+  }
+
+  if (lines >= MAX_LINES) {
+    errno = ENOSPC;
+    t_print("%s: too many input lines configured\n", __func__);
+    return -1;
+  }
+
+  request = request_single_line(chip, offset, GPIOD_LINE_DIRECTION_INPUT, GPIOD_LINE_EDGE_BOTH,
+                                pullup ? GPIOD_LINE_BIAS_PULL_UP : GPIOD_LINE_BIAS_PULL_DOWN,
+                                GPIOD_LINE_VALUE_INACTIVE);
+
+  if (request == NULL) {
+    t_print("%s: line %d request failed: %s\n", __func__, offset, g_strerror(errno));
+    return -1;
+  }
+
+  gpiod_line_request_release(request);
+  monitor_lines[lines] = (unsigned int)offset;
+  monitor_pullups[lines] = pullup;
+  lines++;
+  return 0;
+}
+
+static struct gpiod_line_request *setup_output_line(struct gpiod_chip *chip, int offset, int initialValue)  {
+  //
+  // Setup an active-high output line and return the line request
+  // (in case of failure: NULL).
+  //
+  t_print("%s: %d\n", __func__, offset);
+
+  struct gpiod_line_request *request = request_single_line(chip, offset, GPIOD_LINE_DIRECTION_OUTPUT,
+                                      GPIOD_LINE_EDGE_NONE, GPIOD_LINE_BIAS_AS_IS,
+                                      initialValue ? GPIOD_LINE_VALUE_ACTIVE : GPIOD_LINE_VALUE_INACTIVE);
+
+  if (request == NULL) {
+    t_print("%s: line request failed for offset %d: %s\n", __func__, offset, g_strerror(errno));
+  }
+
+  return request;
+}
